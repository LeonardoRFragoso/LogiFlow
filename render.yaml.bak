# =============================================
# LogiFlow CRM - Render.com Blueprint COMPLETO
# Deploy: Backend + 4 Frontends + DB + Redis
# =============================================

services:
  # ========================================
  # Backend - FastAPI
  # ========================================
  - type: web
    name: logiflow-api
    env: python
    region: oregon
    plan: free
    branch: main
    buildCommand: |
      cd "LogiFlow CRM/backend"
      pip install --upgrade pip
      pip install -r requirements.txt
    preDeployCommand: |
      cd "LogiFlow CRM/backend"
      alembic upgrade head || echo "Migration skipped or failed - will retry on next deploy"
    startCommand: |
      cd "LogiFlow CRM/backend"
      uvicorn main:app --host 0.0.0.0 --port $PORT
    healthCheckPath: /health
    envVars:
      - key: DATABASE_URL
        fromDatabase:
          name: logiflow-db
          property: connectionString
      - key: REDIS_URL
        fromService:
          type: redis
          name: logiflow-redis
          property: connectionString
      - key: SECRET_KEY
        generateValue: true
      - key: ALGORITHM
        value: HS256
      - key: ACCESS_TOKEN_EXPIRE_MINUTES
        value: 30
      - key: REFRESH_TOKEN_EXPIRE_DAYS
        value: 7
      - key: DEBUG
        value: false
      - key: API_PREFIX
        value: /api
      - key: API_VERSION
        value: v1
      - key: ALLOWED_ORIGINS
        value: "*"

  # ========================================
  # Frontend - Vue 3 (Static Site)
  # ========================================
  - type: web
    name: logiflowcrm
    env: static
    branch: main
    buildCommand: |
      cd "LogiFlow CRM/frontend"
      npm install
      npm run build
    staticPublishPath: LogiFlow CRM/frontend/dist
    routes:
      - type: rewrite
        source: /api/*
        destination: https://logiflow-api.onrender.com/api/*
    headers:
      - path: /*
        name: X-Frame-Options
        value: SAMEORIGIN
      - path: /*
        name: X-Content-Type-Options
        value: nosniff
      - path: /*
        name: X-XSS-Protection
        value: 1; mode=block

  # ========================================
  # App do Motorista - PWA (Static Site)
  # ========================================
  - type: web
    name: logiflow-app-motorista
    env: static
    branch: main
    buildCommand: |
      cd "LogiFlow CRM/app-motorista"
      npm install
      npm run build
    staticPublishPath: LogiFlow CRM/app-motorista/dist
    routes:
      - type: rewrite
        source: /api/*
        destination: https://logiflow-api.onrender.com/api/*
    headers:
      - path: /*
        name: X-Frame-Options
        value: SAMEORIGIN
      - path: /*
        name: X-Content-Type-Options
        value: nosniff

  # ========================================
  # Portal do Cliente - Tracking (Static Site)
  # ========================================
  - type: web
    name: logiflow-portal-cliente
    env: static
    branch: main
    buildCommand: |
      cd "LogiFlow CRM/portal-cliente"
      npm install
      npm run build
    staticPublishPath: LogiFlow CRM/portal-cliente/dist
    routes:
      - type: rewrite
        source: /api/*
        destination: https://logiflow-api.onrender.com/api/*
    headers:
      - path: /*
        name: X-Frame-Options
        value: SAMEORIGIN
      - path: /*
        name: X-Content-Type-Options
        value: nosniff

  # ========================================
  # Site de Divulgação - Landing Page (Static Site)
  # ========================================
  - type: web
    name: logiflow-site
    env: static
    branch: main
    buildCommand: |
      cd "LogiFlow CRM/site-divulgacao"
      npm install
      npm run build
    staticPublishPath: LogiFlow CRM/site-divulgacao/dist
    headers:
      - path: /*
        name: X-Frame-Options
        value: SAMEORIGIN
      - path: /*
        name: X-Content-Type-Options
        value: nosniff
      - path: /*
        name: Cache-Control
        value: public, max-age=3600

  # ========================================
  # Redis
  # ========================================
  - type: redis
    name: logiflow-redis
    plan: free
    region: oregon
    maxmemoryPolicy: allkeys-lru
    ipAllowList: []

# ========================================
# Database - PostgreSQL
# ========================================
databases:
  - name: logiflow-db
    databaseName: logiflow
    plan: free
    region: oregon
    ipAllowList: []

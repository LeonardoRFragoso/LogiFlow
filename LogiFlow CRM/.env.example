# =============================================
# LogiFlow CRM - Environment Variables
# =============================================
# Copie este arquivo para .env e configure os valores

# Ambiente
ENV=development
DEBUG=true

# =========================================
# Banco de Dados (MariaDB)
# =========================================
DB_ROOT_PASSWORD=rootpass123_CHANGE_ME
DB_HOST=db
DB_NAME=logiflow_crm
DB_USER=logiflow
DB_PASSWORD=logiflow123_CHANGE_ME
DB_PORT=3306

# =========================================
# Redis
# =========================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redis123_CHANGE_ME

# =========================================
# SuiteCRM
# =========================================
SITE_URL=http://localhost
SUITECRM_URL=http://suitecrm

# OAuth2 Credentials (gerar após instalação)
SUITECRM_CLIENT_ID=
SUITECRM_CLIENT_SECRET=

# =========================================
# API Backend (FastAPI)
# =========================================
JWT_SECRET=change-this-to-a-very-long-random-string-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# =========================================
# Integrações Fiscais
# =========================================
# Focus NFe (CT-e/MDF-e)
FOCUSNFE_TOKEN=
FOCUSNFE_ENVIRONMENT=homologacao

# =========================================
# Integrações de Comunicação
# =========================================
# WhatsApp (Evolution API)
EVOLUTION_API_URL=
EVOLUTION_API_KEY=

# E-mail (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=LogiFlow CRM
SMTP_FROM_EMAIL=noreply@logiflow.com.br

# =========================================
# Storage (S3/MinIO)
# =========================================
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=logiflow-uploads
S3_REGION=us-east-1

# =========================================
# Monitoramento
# =========================================
SENTRY_DSN=

# =========================================
# Billing (Asaas)
# =========================================
ASAAS_API_KEY=
ASAAS_ENVIRONMENT=sandbox

# =============================================
# LogiFlow CRM - Variáveis Docker Compose
# =============================================
# Copie este arquivo para .env antes de executar docker-compose
# cp .env.docker .env

# =============================================
# BANCO DE DADOS
# =============================================
DB_ROOT_PASSWORD=rootpass123
DB_NAME=logiflow
DB_USER=logiflow
DB_PASSWORD=logiflow123
DB_PORT=5432
DATABASE_URL=postgresql://logiflow:logiflow123@db:5432/logiflow

# =============================================
# REDIS
# =============================================
REDIS_PASSWORD=redis123
REDIS_PORT=6379

# =============================================
# APLICAÇÃO
# =============================================
DEBUG=True
SECRET_KEY=change-this-in-production-to-a-very-secure-random-key
ALLOWED_HOSTS=localhost,127.0.0.1,logiflow_api,api

# URLs
SITE_URL=http://localhost:8080
API_PREFIX=/api
API_VERSION=v1

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173,http://localhost:8080

# =============================================
# INTEGRAÇÕES EXTERNAS
# =============================================

# Focus NFe (CT-e/MDF-e)
FOCUSNFE_TOKEN=

# WhatsApp Evolution API
EVOLUTION_API_URL=http://localhost:8081
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE_NAME=logiflow

# Google Maps
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_DISTANCE_MATRIX_KEY=

# Mercado Pago (Pagamentos)
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
CHECKOUT_SUCCESS_URL=http://localhost:3001/checkout/success
CHECKOUT_FAILURE_URL=http://localhost:3001/checkout/failure
CHECKOUT_PENDING_URL=http://localhost:3001/checkout/pending

# ERPs
OMIE_APP_KEY=
OMIE_APP_SECRET=
BLING_ACCESS_TOKEN=

# Melhor Envio
MELHOR_ENVIO_TOKEN=
MELHOR_ENVIO_SANDBOX=true
FRENET_TOKEN=

# Rastreadores GPS (Simulação ativa por padrão)
SASCAR_API_KEY=
SASCAR_API_SECRET=
SASCAR_SIMULATION_MODE=true

AUTOTRAC_USERNAME=
AUTOTRAC_PASSWORD=
AUTOTRAC_SIMULATION_MODE=true

ONIXSAT_API_TOKEN=
ONIXSAT_SIMULATION_MODE=true

# =============================================
# EMAIL SMTP
# =============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
FROM_EMAIL=noreply@logiflow.com.br
FROM_NAME=LogiFlow CRM
SALES_EMAIL=vendas@logiflow.com.br

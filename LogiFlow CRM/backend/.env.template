# ========================================
# 🔐 LOGIFLOW CRM - CONFIGURAÇÃO SEGURA
# ========================================
# 
# ATENÇÃO: Este é um TEMPLATE. Copie para .env e preencha com valores reais.
# NUNCA commite o arquivo .env com credenciais!
#
# Para criar seu .env:
#   cp .env.template .env
#   # Edite .env com suas credenciais reais
#

# ========================================
# DATABASE
# ========================================
DATABASE_URL=sqlite:///./logiflow.db
SQLALCHEMY_DATABASE_URI=sqlite:///./logiflow.db

# Para PostgreSQL (produção):
# DATABASE_URL=postgresql://usuario:senha@localhost:5432/logiflow
# SQLALCHEMY_DATABASE_URI=postgresql://usuario:senha@localhost:5432/logiflow

# ========================================
# SECURITY - CRÍTICO! 🔐
# ========================================
# Gere chaves fortes com: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=GERAR_CHAVE_SECRETA_AQUI_32_BYTES_MINIMO
JWT_SECRET_KEY=GERAR_CHAVE_JWT_AQUI_32_BYTES_MINIMO

# ========================================
# EMAIL SMTP - ⚠️ NUNCA EXPONHA ESTAS CREDENCIAIS!
# ========================================
# Para Gmail: 
#   1. Ative verificação em 2 etapas
#   2. Gere senha de app: https://myaccount.google.com/security
#   3. Use a senha de app (16 caracteres) no SMTP_PASSWORD
#
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu-email@gmail.com
SMTP_PASSWORD=<YOUR_GMAIL_APP_PASSWORD_HERE>
FROM_EMAIL=noreply@logiflow.com.br
FROM_NAME=LogiFlow CRM
SALES_EMAIL=vendas@logiflow.com.br

# ========================================
# APPLICATION
# ========================================
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
FRONTEND_URL=http://localhost:5173
ENVIRONMENT=development

# ========================================
# CELERY (Redis)
# ========================================
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ========================================
# INTEGRATIONS (Opcional)
# ========================================
# Melhor Envio
MELHOR_ENVIO_CLIENT_ID=
MELHOR_ENVIO_CLIENT_SECRET=
MELHOR_ENVIO_SANDBOX=true

# Google Maps
GOOGLE_MAPS_API_KEY=

# ========================================
# TENANT/MULTI-COMPANY (Opcional)
# ========================================
DEFAULT_TENANT_ID=1

# ========================================
# LOGGING
# ========================================
LOG_LEVEL=INFO
# Opções: DEBUG, INFO, WARNING, ERROR, CRITICAL

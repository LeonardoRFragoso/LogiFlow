# ========================================
# LogiFlow CRM - Railway Environment Variables
# ========================================
# Configure estas variáveis no Railway Dashboard
# Settings > Variables

# App Configuration
DEBUG=False
SECRET_KEY=${{SECRET_KEY}}
API_PREFIX=/api
API_VERSION=v1

# CORS - URLs permitidas (separadas por vírgula)
# Adicione o domínio do seu frontend Railway aqui
ALLOWED_ORIGINS=https://seu-frontend.railway.app,https://logiflow.com.br

# Database (PostgreSQL) - Railway fornece automaticamente
# Railway injeta DATABASE_URL automaticamente quando você adiciona PostgreSQL
DATABASE_URL=${{DATABASE_URL}}

# Ou use variáveis individuais se preferir:
# DB_HOST=${{PGHOST}}
# DB_NAME=${{PGDATABASE}}
# DB_USER=${{PGUSER}}
# DB_PASSWORD=${{PGPASSWORD}}
# DB_PORT=${{PGPORT}}

# Redis (Cache) - Railway fornece automaticamente
# Railway injeta REDIS_URL automaticamente quando você adiciona Redis
REDIS_URL=${{REDIS_URL}}

# Ou use variáveis individuais se preferir:
# REDIS_HOST=${{REDIS_HOST}}
# REDIS_PORT=${{REDIS_PORT}}
# REDIS_PASSWORD=${{REDIS_PASSWORD}}

# Focus NFe (CT-e/MDF-e)
FOCUSNFE_TOKEN=${{FOCUSNFE_TOKEN}}
FOCUSNFE_ENVIRONMENT=producao

# ========================================
# WhatsApp / Evolution API
# ========================================
EVOLUTION_API_URL=${{EVOLUTION_API_URL}}
EVOLUTION_API_KEY=${{EVOLUTION_API_KEY}}
EVOLUTION_INSTANCE_NAME=logiflow

# ========================================
# Google Maps API
# ========================================
GOOGLE_MAPS_API_KEY=${{GOOGLE_MAPS_API_KEY}}
GOOGLE_MAPS_DISTANCE_MATRIX_KEY=${{GOOGLE_MAPS_DISTANCE_MATRIX_KEY}}

# ========================================
# Mercado Pago (Pagamentos)
# ========================================
MERCADOPAGO_ACCESS_TOKEN=${{MERCADOPAGO_ACCESS_TOKEN}}
MERCADOPAGO_PUBLIC_KEY=${{MERCADOPAGO_PUBLIC_KEY}}
MERCADOPAGO_WEBHOOK_URL=https://seu-backend.railway.app/api/billing/webhooks/mercadopago

# URLs de retorno após pagamento
CHECKOUT_SUCCESS_URL=https://seu-frontend.railway.app/checkout/success
CHECKOUT_FAILURE_URL=https://seu-frontend.railway.app/checkout/failure
CHECKOUT_PENDING_URL=https://seu-frontend.railway.app/checkout/pending

# ========================================
# Integrações ERP
# ========================================
# Omie ERP
OMIE_APP_KEY=${{OMIE_APP_KEY}}
OMIE_APP_SECRET=${{OMIE_APP_SECRET}}

# Bling ERP
BLING_ACCESS_TOKEN=${{BLING_ACCESS_TOKEN}}

# ========================================
# Melhor Envio (Cotação de Frete)
# ========================================
MELHOR_ENVIO_TOKEN=${{MELHOR_ENVIO_TOKEN}}
MELHOR_ENVIO_SANDBOX=false

# Frenet
FRENET_TOKEN=${{FRENET_TOKEN}}

# ========================================
# Rastreamento GPS
# ========================================
# Sascar
SASCAR_API_KEY=${{SASCAR_API_KEY}}
SASCAR_API_SECRET=${{SASCAR_API_SECRET}}
SASCAR_SIMULATION_MODE=false

# Autotrac
AUTOTRAC_USERNAME=${{AUTOTRAC_USERNAME}}
AUTOTRAC_PASSWORD=${{AUTOTRAC_PASSWORD}}
AUTOTRAC_SIMULATION_MODE=false

# Onixsat
ONIXSAT_API_TOKEN=${{ONIXSAT_API_TOKEN}}
ONIXSAT_SIMULATION_MODE=false

# ========================================
# Email (SMTP)
# ========================================
SMTP_HOST=${{SMTP_HOST}}
SMTP_PORT=${{SMTP_PORT}}
SMTP_USER=${{SMTP_USER}}
SMTP_PASSWORD=${{SMTP_PASSWORD}}
FROM_EMAIL=noreply@logiflow.com.br
FROM_NAME=LogiFlow CRM
SALES_EMAIL=vendas@logiflow.com.br

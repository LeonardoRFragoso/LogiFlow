# ========================================
# LogiFlow CRM - Configurações de Ambiente
# ========================================
# Copie este arquivo para .env e preencha os valores

# App
DEBUG=True
SECRET_KEY=change-this-in-production-to-a-secure-key

# CORS - URLs permitidas (separadas por vírgula)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176,http://localhost:5177,http://localhost:5178

# Database (PostgreSQL)
# IMPORTANTE: Em Docker, use 'db' (nome do serviço). Fora do Docker, use 'localhost'
DB_HOST=db
DB_NAME=logiflow
DB_USER=logiflow
DB_PASSWORD=logiflow123
DB_PORT=5432

# Redis (Cache)
# IMPORTANTE: Em Docker, use 'redis' (nome do serviço). Fora do Docker, use 'localhost'
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redis123

# Focus NFe (CT-e/MDF-e)
FOCUSNFE_TOKEN=

# ========================================
# WhatsApp / Evolution API
# ========================================
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=REDACTED_EVOLUTION_API_KEY
EVOLUTION_INSTANCE_NAME=logiflow

# ========================================
# Google Maps API
# ========================================
GOOGLE_MAPS_API_KEY=

# ========================================
# Mercado Pago (Pagamentos)
# ========================================
# Credenciais de TESTE
MERCADOPAGO_ACCESS_TOKEN=TEST-9fe539d2-d988-4714-aab9-8810bd5743a3
MERCADOPAGO_PUBLIC_KEY=TEST-c4f6c02a-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Credenciais de PRODUÇÃO (obter após homologação)
# MERCADOPAGO_ACCESS_TOKEN=APP_USR-4450394951038830-xxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-175427787
# MERCADOPAGO_PUBLIC_KEY=APP_USR-xxxxxxxx-xxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# URLs de retorno após pagamento
CHECKOUT_SUCCESS_URL=http://localhost:3001/checkout/success
CHECKOUT_FAILURE_URL=http://localhost:3001/checkout/failure
CHECKOUT_PENDING_URL=http://localhost:3001/checkout/pending

# Webhook URL (configurar no painel do MP)
# https://api.logiflow.com.br/api/billing/webhooks/mercadopago

# ========================================
# Integrações ERP
# ========================================
# Omie ERP
OMIE_APP_KEY=
OMIE_APP_SECRET=

# Bling ERP
BLING_ACCESS_TOKEN=

# ========================================
# Melhor Envio (Cotação de Frete)
# ========================================
# Melhor Envio
MELHOR_ENVIO_TOKEN=seu_token_aqui
MELHOR_ENVIO_SANDBOX=true

# Frenet
FRENET_TOKEN=seu_token_frenet_aqui

# ========================================
# Rastreamento GPS (Modo Simulação Ativo)
# ========================================
# Sascar
SASCAR_API_KEY=
SASCAR_API_SECRET=
SASCAR_SIMULATION_MODE=true

# Autotrac
AUTOTRAC_USERNAME=
AUTOTRAC_PASSWORD=
AUTOTRAC_SIMULATION_MODE=true

# Onixsat
ONIXSAT_API_TOKEN=
ONIXSAT_SIMULATION_MODE=true

# ========================================
# Email (SMTP)
# ========================================# ⚠️ Email Configuration (Gmail)
# IMPORTANTE: NUNCA commitar o arquivo .env com credenciais reais!
# Para Gmail: Gere uma senha de app em https://myaccount.google.com/security
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu-email@gmail.com
SMTP_PASSWORD=<YOUR_GMAIL_APP_PASSWORD_HERE>
FROM_EMAIL=noreply@logiflow.com.br
FROM_NAME=LogiFlow CRM
SALES_EMAIL=vendas@logiflow.com.br

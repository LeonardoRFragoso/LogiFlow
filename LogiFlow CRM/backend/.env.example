# =============================================
# LogiFlow CRM - Environment Variables
# =============================================
# Copie este arquivo para .env e configure os valores

# Ambiente
ENV=development
DEBUG=true

# =========================================
# Banco de Dados (PostgreSQL)
# =========================================
DB_ROOT_PASSWORD=rootpass123_CHANGE_ME
DB_HOST=db
DB_NAME=logiflow
DB_USER=logiflow
DB_PASSWORD=logiflow123_CHANGE_ME
DB_PORT=5432

# =========================================
# Redis
# =========================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redis123_CHANGE_ME

# =========================================
# API Backend (FastAPI)
# =========================================
JWT_SECRET=change-this-to-a-very-long-random-string-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# =========================================
# Integrações Fiscais
# =========================================
# Focus NFe (CT-e/MDF-e)
# Obtenha em: https://focusnfe.com.br
FOCUSNFE_TOKEN=
FOCUSNFE_ENVIRONMENT=homologacao

# =========================================
# Integrações de Frete
# =========================================
# Melhor Envio - https://melhorenvio.com.br
MELHOR_ENVIO_TOKEN=
MELHOR_ENVIO_SANDBOX=true

# Frenet - https://frenet.com.br
FRENET_TOKEN=

# Google Maps - https://console.cloud.google.com
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_DISTANCE_MATRIX_KEY=

# =========================================
# Integrações de Comunicação
# =========================================
# WhatsApp (Evolution API)
EVOLUTION_API_URL=
EVOLUTION_API_KEY=

# E-mail (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=LogiFlow CRM
SMTP_FROM_EMAIL=noreply@logiflow.com.br

# =========================================
# Storage (S3/MinIO)
# =========================================
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=logiflow-uploads
S3_REGION=us-east-1

# =========================================
# Monitoramento
# =========================================
SENTRY_DSN=

# =========================================
# Billing (Mercado Pago)
# =========================================
# Obtenha em: https://www.mercadopago.com.br/developers/panel/app
# Sandbox (Testes): TEST-XXXX
# Produção: APP-XXXX
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_WEBHOOK_URL=https://api.logiflow.com.br/api/billing/webhooks/mercadopago

# URLs de retorno após checkout
CHECKOUT_SUCCESS_URL=https://app.logiflow.com.br/checkout/success
CHECKOUT_FAILURE_URL=https://app.logiflow.com.br/checkout/failure
CHECKOUT_PENDING_URL=https://app.logiflow.com.br/checkout/pending

# =========================================
# Billing (Asaas) - LEGACY
# =========================================
ASAAS_API_KEY=
ASAAS_ENVIRONMENT=sandbox

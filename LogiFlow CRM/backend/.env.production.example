# ========================================
# LogiFlow CRM - Configuração de Produção
# ========================================

# ========================================
# Backend (API)
# ========================================
API_URL=https://api.logiflow.com.br
API_PORT=8000
DEBUG=False
ENVIRONMENT=production

# ========================================
# Banco de Dados (PostgreSQL Produção)
# ========================================
DATABASE_URL=postgresql://logiflow_user:SENHA_SEGURA@db.logiflow.com.br:5432/logiflow_prod

# MySQL para Tenants Isolados
DB_HOST=mysql.logiflow.com.br
DB_PORT=3306
DB_ROOT_USER=root
DB_ROOT_PASSWORD=SENHA_MYSQL_ROOT_SEGURA

# ========================================
# Redis (Cache e Sessões)
# ========================================
REDIS_HOST=redis.logiflow.com.br
REDIS_PORT=6379
REDIS_PASSWORD=SENHA_REDIS_SEGURA
REDIS_DB=0

# ========================================
# Mercado Pago (Produção)
# ========================================
MERCADOPAGO_ACCESS_TOKEN=APP-XXXXXXXXXXXXXXXXXX
MERCADOPAGO_PUBLIC_KEY=APP-XXXXXXXXXXXXXXXXXX
MERCADOPAGO_WEBHOOK_SECRET=seu_webhook_secret_aqui

# URLs de Callback
SUCCESS_URL=https://app.logiflow.com.br/checkout/success
FAILURE_URL=https://app.logiflow.com.br/checkout/failure
PENDING_URL=https://app.logiflow.com.br/checkout/pending

# Webhook URL (configurar no painel do MP)
# https://api.logiflow.com.br/api/billing/webhooks/mercadopago

# ========================================
# Email (SMTP Produção)
# ========================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@logiflow.com.br
SMTP_PASSWORD=<YOUR_GMAIL_APP_PASSWORD_HERE>
FROM_EMAIL=noreply@logiflow.com.br
FROM_NAME=LogiFlow CRM
SALES_EMAIL=vendas@logiflow.com.br

# ========================================
# JWT e Segurança
# ========================================
SECRET_KEY=GERAR_CHAVE_SECRETA_FORTE_AQUI_64_CARACTERES_MINIMO
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ========================================
# CORS (Origens Permitidas)
# ========================================
CORS_ORIGINS=https://app.logiflow.com.br,https://logiflow.com.br

# ========================================
# AWS S3 (Armazenamento de Arquivos)
# ========================================
AWS_ACCESS_KEY_ID=AKIAXXXXXXXXXXXXXXXXX
AWS_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AWS_REGION=sa-east-1
S3_BUCKET=logiflow-prod-files

# ========================================
# Google Maps API
# ========================================
GOOGLE_MAPS_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ========================================
# WhatsApp Business API
# ========================================
WHATSAPP_API_URL=https://graph.facebook.com/v18.0
WHATSAPP_ACCESS_TOKEN=EAXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
WHATSAPP_PHONE_NUMBER_ID=123456789012345

# ========================================
# Sentry (Monitoramento de Erros)
# ========================================
SENTRY_DSN=https://xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx@sentry.io/1234567

# ========================================
# Logs
# ========================================
LOG_LEVEL=INFO
LOG_FILE=/var/log/logiflow/api.log

# ========================================
# Rate Limiting
# ========================================
RATE_LIMIT_ENABLED=True
RATE_LIMIT_PER_MINUTE=60

# ========================================
# Backup
# ========================================
BACKUP_ENABLED=True
BACKUP_SCHEDULE=0 2 * * *  # Diariamente às 2h
BACKUP_RETENTION_DAYS=30
BACKUP_S3_BUCKET=logiflow-prod-backups
